# ============================================================
# AssetIQ — Variables d'environnement
# Copier ce fichier : cp .env.example .env.local
# Ne JAMAIS committer .env.local sur Git
# ============================================================

# --- IA Anthropic (diagnostic visuel) -----------------------
# Obtenir sur : https://console.anthropic.com → API Keys
# Modèle utilisé : claude-sonnet-4-5
# Sans cette clé : le diagnostic IA tourne en mode MOCK (réponse simulée, app fonctionnelle)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Resend (emails de notification admin) ------------------
# Obtenir sur : https://resend.com → API Keys → "Sending access"
# Sans cette clé : les emails ne partent pas (silencieux, pas d'erreur bloquante)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Email de réception des notifications -------------------
# Adresse qui reçoit le dossier complet à chaque nouvelle panne soumise
ADMIN_EMAIL=votre-email@exemple.com

# --- URL de l'application -----------------------------------
# Local : http://localhost:3000
# Production Vercel : https://votre-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (base de données — optionnel) -----------------
# Obtenir sur : https://supabase.com → votre projet → Settings → API
# Sans ces clés : l'app fonctionne avec les données en mémoire (sample-data.ts)
# Pour activer Supabase : exécuter supabase/schema.sql dans le SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key
